# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Aqara Camera RTSP URL
# Format: rtsp://username:password@camera-ip:554/stream
CAMERA_RTSP_URL=rtsp://user:pass@192.168.1.x:554/stream

# Home Assistant (for lights — leave blank until Phase 7)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Google Calendar credentials file path (for Phase 6)
GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# HANUMAN API server token (for web UI — Phase 9)
HANUMAN_API_TOKEN=change-me-to-something-secret
